{
  "name": "cbdg-credit-automation",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "bun run scripts/run.ts",
    "build:dist": "bun run scripts/build-dist.ts",
    "proxy-check": "bun run scripts/proxy-check.ts",
    "build": "echo no-build-needed (bun runs TS directly)",
    "test": "bun run test:library && bun run test:app-units && bun run test:runner && bun run test:queue && bun run test:crusoe-units && bun run test:crusoe-queue && bun run test:webshare-units && bun run test:webshare-queue && bun run test:fastrouter-units && bun run test:fastrouter-queue && bun run test:tokenharbor-units && bun run test:tokenharbor-queue && bun run test:launcher && bun run test:proxy-check",
    "test:library": "bun test packages/google-oauth/src/config.test.ts packages/google-oauth/src/units.test.ts packages/google-oauth/src/tempmail.test.ts packages/google-oauth/src/browser.integration.test.ts",
    "test:app-units": "bun test apps/cbdg/src/units.test.ts",
    "test:runner": "bun test apps/cbdg/src/runner.test.ts",
    "test:queue": "bun test apps/cbdg/src/queue.test.ts",
    "test:crusoe-units": "bun test apps/crusoe/src/units.test.ts",
    "test:crusoe-queue": "bun test apps/crusoe/src/queue.test.ts",
    "typecheck": "bun tsc --noEmit -p tsconfig.json",
    "cbdg": "bun run apps/cbdg/src/cli.ts",
    "crusoe": "bun run apps/crusoe/src/cli.ts",
    "webshare": "bun run apps/webshare/src/cli.ts",
    "fastrouter": "bun run apps/fastrouter/src/cli.ts",
    "tokenharbor": "bun run apps/tokenharbor/src/cli.ts",
    "fastrouter:python": "/home/azhar/.venvs/camoufox/bin/python apps/fastrouter/camoufox_runner.py",
    "crusoe:python": "/home/azhar/.venvs/camoufox/bin/python apps/crusoe/camoufox_runner.py",
    "tokenharbor:python": "/home/azhar/.venvs/camoufox/bin/python apps/tokenharbor/camoufox_runner.py",
    "test:fastrouter-units": "bun test apps/fastrouter/src/units.test.ts",
    "test:fastrouter-queue": "bun test apps/fastrouter/src/queue.test.ts",
    "test:tokenharbor-units": "bun test apps/tokenharbor/src/units.test.ts",
    "test:tokenharbor-queue": "bun test apps/tokenharbor/src/queue.test.ts",
    "test:webshare-units": "bun test apps/webshare/src/units.test.ts",
    "test:webshare-queue": "bun test apps/webshare/src/queue.test.ts",
    "test:launcher": "bun test scripts/plan.test.ts",
    "test:proxy-check": "bun test scripts/proxy-lib.test.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
