# ── cbdg app ───────────────────────────────────────────────────────
# Region chosen at /register/user/complete (two-letter ISO / label)
REGION=SG
# Parallel workers (keep 1 until proxy support is wired)
WORKERS=1
# Run browsers headless (recommended: false so you can solve 3DS/captcha)
HEADLESS=false

# Timeouts (seconds)
WAIT_3DS_TIMEOUT_SEC=180
OPEN_PAYMENT_TIMEOUT_SEC=120
LINK_CARD_TIMEOUT_SEC=180
CREDIT_VERIFY_TIMEOUT_SEC=60
MAX_RETRY_PER_ACCOUNT=1

# Seed files (relative to repo root)
SEED_GSUITE=./gsuite.txt
SEED_VCC=./vcc.txt
SEED_PROXY=./proxy.txt

# Outputs
STATE_FILE=./state.jsonl
# Result files (email = first |-field); re-run skips what is already recorded
RESULT_SUCCESS_FILE=./akun-result.txt
RESULT_FAILED_FILE=./akun-failed.txt
# Re-process accounts listed in akun-failed.txt (default false).
# Accounts failed with ACCOUNT_RESTRICTED are NEVER retried — the ban is permanent.
RETRY_FAILED=false
# Min seconds between accounts per worker (risk-control spacing; 0 = off).
# A random 0-50% jitter is added on top. Recommended: 60-180 when unproxied.
INTER_ACCOUNT_DELAY_SEC=0
SCREENSHOT_DIR=./screenshots

# ── crusoe app ─────────────────────────────────────────────────────
# Reuses SEED_GSUITE / SEED_PROXY / WORKERS / HEADLESS / RETRY_FAILED /
# INTER_ACCOUNT_DELAY_SEC from above. Outputs are namespaced CRUSOE_* so the
# two apps never overwrite each other's state/results files.
SIGNUP_FORM_TIMEOUT_SEC=45
API_KEY_TIMEOUT_SEC=180
CREDITS_TIMEOUT_SEC=30
# UI cadence: fast | human (default) | careful. Does NOT replace
# INTER_ACCOUNT_DELAY_SEC — that is the knob risk control actually sees.
# PACE=human
CRUSOE_STATE_FILE=./state-crusoe.jsonl
CRUSOE_RESULT_SUCCESS_FILE=./akun-result-crusoe.txt
CRUSOE_RESULT_FAILED_FILE=./akun-failed-crusoe.txt
CRUSOE_APIKEY_FILE=./apikey.txt
CRUSOE_SCREENSHOT_DIR=./screenshots-crusoe

# ── @ifqy/google-oauth library ─────────────────────────────────────
# GOOGLE_OAUTH_HEADLESS=false
# GOOGLE_OAUTH_CONSENT_MS=90000
# GOOGLE_OAUTH_PASSWORD_MS=60000
# GOOGLE_OAUTH_SIGNIN_MS=30000
# GOOGLE_OAUTH_CAPTCHA_MS=180000
# GOOGLE_OAUTH_FAIL_ON_CAPTCHA=true
# Pace for the library itself (the app passes its own PACE through).
# GOOGLE_OAUTH_PACE=human
# Typing delays default to the pace profile; set these only to override it.
# GOOGLE_OAUTH_TYPE_MIN=30
# GOOGLE_OAUTH_TYPE_MAX=90
# Click generic "login / sign in" text while hunting the Google button.
# Needed on sites that hide the provider behind a login route; harmful on
# sites (crusoe) that show the Google button on the landing page itself —
# the crusoe flow always turns it off in code.
# GOOGLE_OAUTH_GENERIC_AUTH_CLICK=true
